NODE_ENV=development
PORT=5000
# Temporary Windows development workaround for Atlas SRV lookup failures.
# Set true only in development; set false or remove it after system DNS is fixed.
DEV_USE_PUBLIC_DNS=false
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/foodsurplus

JWT_ACCESS_SECRET=replace_with_long_random_string_32_chars_min
JWT_REFRESH_SECRET=replace_with_another_long_random_string_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
